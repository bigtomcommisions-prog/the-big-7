# ── Production only (docker compose + Caddy) ─────────────────────────
# APP_DOMAIN=world.example.com
# VOICE_DOMAIN=voice.example.com

# ── App ──────────────────────────────────────────────────────────────
# Public origin the browser uses. In dev this is the Vite server (it proxies /api, /auth, /ws).
APP_ORIGIN=http://localhost:5173
PORT=3000
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# SQLite file (created automatically)
DATABASE_URL=file:./data/hearthvale.db

# ── Discord (https://discord.com/developers/applications) ─────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must exactly match a redirect registered in the Developer Portal → OAuth2
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

# ── Voice (LiveKit) ──────────────────────────────────────────────────
# Local dev: run `livekit-server --dev` (key devkey / secret secret).
# URL the *browser* connects to:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Optional: URL the server itself uses to reach LiveKit (defaults to LIVEKIT_URL)
LIVEKIT_SERVER_URL=
# Bridge Discord voice channels into the world's voice gazebos (bot joins the channel). true/false
DISCORD_VOICE_BRIDGE=true

# ── Tuning (optional) ────────────────────────────────────────────────
# Messages sent from the world per user: N per WINDOW seconds
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW=10
